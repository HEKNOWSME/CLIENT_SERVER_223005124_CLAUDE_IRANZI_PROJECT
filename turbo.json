{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV", "DATABASE_URL", "API_HOST", "API_PORT", "API_ORIGIN", "WEB_ORIGIN",
    "JWT_ACCESS_SECRET", "JWT_ACCESS_TTL_SECONDS", "REFRESH_TOKEN_PEPPER", "REFRESH_TOKEN_TTL_DAYS",
    "LOGIN_MAX_FAILED_ATTEMPTS", "LOGIN_LOCKOUT_MINUTES", "SEED_DEMO_PASSWORD"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] }
  }
}
