# Local development only. `pnpm env:init` copies this file to .env and replaces
# every *_generated_* placeholder with a random value.
NODE_ENV=development
DATABASE_URL=postgresql://pmrms:pmrms_dev_password@127.0.0.1:5432/pmrms?schema=public
POSTGRES_USER=pmrms
POSTGRES_PASSWORD=pmrms_dev_password
POSTGRES_DB=pmrms
POSTGRES_PORT=5432
API_HOST=127.0.0.1
API_PORT=3001
API_ORIGIN=http://127.0.0.1:3001
WEB_ORIGIN=http://localhost:3000

# Authentication. Secrets must be at least 32 characters and must differ.
JWT_ACCESS_SECRET=jwt_access_generated_secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_PEPPER=refresh_pepper_generated_secret
REFRESH_TOKEN_TTL_DAYS=7

# Shared password for the fictional demo accounts created by `pnpm db:seed`.
SEED_DEMO_PASSWORD=Demo@Pmrms2026!

# Local development prints codes in the API terminal. Set OTP_DELIVERY=resend to send email.
OTP_DELIVERY=local
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=PMRMS <onboarding@your-verified-domain.com>
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Optional hosted integrations. See README.md.
PDF_STORAGE=postgres
REALTIME_PROVIDER=disabled
# DATABASE_MIGRATION_URL=postgresql://OWNER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# SUPABASE_REALTIME_SIGNING_JWK='{"kty":"EC","crv":"P-256","kid":"...","x":"...","y":"...","d":"..."}'
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
