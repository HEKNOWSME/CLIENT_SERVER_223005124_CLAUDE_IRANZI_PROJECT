# Local development only. pnpm env:init creates .env with a random DB password.
DATABASE_URL=postgresql://pmrms:pmrms_dev_password@127.0.0.1:5432/pmrms?schema=public
POSTGRES_USER=pmrms
POSTGRES_PASSWORD=pmrms_dev_password
POSTGRES_DB=pmrms
POSTGRES_PORT=5432
API_HOST=127.0.0.1
API_PORT=3001
API_ORIGIN=http://127.0.0.1:3001
WEB_ORIGIN=http://localhost:3000
# Supabase Realtime, R2 and custom JWT auth are future feature integrations.
# No cloud credentials are needed for the local connection check.
